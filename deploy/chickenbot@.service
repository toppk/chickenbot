# One instance per domain: chickenbot@hobby, chickenbot@work. %i names both the
# unit and the run directory, and everything else comes from the .env in it, so
# the command line carries nothing. Install:
#   chickenbot init ~/server/chickenbot/hobby
#   mkdir -p ~/.config/systemd/user
#   cp deploy/*.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now chickenbot@hobby chickenbot-github@hobby
#   loginctl enable-linger $USER      # so it survives logout
[Unit]
Description=chickenbot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/chickenbot
# CB_CONFIG_PATH and the secrets both live here; `chickenbot init` writes it.
EnvironmentFile=%h/server/chickenbot/%i/.env
Environment=CB_INSTANCE=%i
ExecStart=%h/.local/bin/uv run chickenbot
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

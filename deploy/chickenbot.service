# systemd --user unit. Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/*.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now chickenbot github-tool
#   loginctl enable-linger $USER      # so it survives logout
[Unit]
Description=chickenbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/chickenbot
ExecStart=%h/.local/bin/uv run chickenbot -c chickenbot.toml
Restart=always
RestartSec=5
# Secrets come from the .env beside the config, which the bot reads itself.

[Install]
WantedBy=default.target

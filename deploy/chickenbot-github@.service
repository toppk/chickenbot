# The tool is independent of the bot: it starts, stops and restarts on its own,
# and reconnects to the socket whenever chickenbot happens to be there. No
# ordering dependency is declared on purpose.
#
# One per instance, not one shared. Each keeps its own mirror and its own
# socket, so a work handle is never fetched into the hobby database and a
# restart in one domain cannot disturb another.
[Unit]
Description=chickenbot github tool (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/chickenbot
# The venv directly, not `uv run`: uv spawns and waits rather than exec'ing, so
# it would sit in the process table as a second copy of every instance. The
# cost is that a dependency change needs `uv sync` by hand, which a service
# quietly mutating its own venv on restart is no better than.
# CB_SOCKET_PATH, CB_GITHUB_DB_PATH, CB_INTERVAL and GITHUB_TOKEN, all from one file.
EnvironmentFile=%h/server/chickenbot/%i/.env
Environment=CB_INSTANCE=%i
ExecStart=%h/workspace/chickenbot/.venv/bin/python -m external.github
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

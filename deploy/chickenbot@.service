# One instance per domain: chickenbot@hobby, chickenbot@work. %i names both the
# unit and the run directory, and everything else comes from the .env in it, so
# the command line carries nothing. Install:
#   cd ~/workspace/chickenbot && ./deploy/deploy.sh
#   chickenbot init ~/server/chickenbot/hobby
#   mkdir -p ~/.config/systemd/user
#   cp deploy/*.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now chickenbot@hobby chickenbot-github@hobby
#   loginctl enable-linger $USER      # so it survives logout
[Unit]
Description=chickenbot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The deployed venv, not the checkout: the service runs what deploy.sh
# installed, so editing the working tree cannot change a running bot. A venv
# path directly rather than `uv run`, which spawns and waits instead of
# exec'ing and would sit in the process table as a second copy per instance.
WorkingDirectory=%h/server/chickenbot/%i
# CB_CONFIG_PATH and the secrets both live here; `chickenbot init` writes it.
EnvironmentFile=%h/server/chickenbot/%i/.env
Environment=CB_INSTANCE=%i
ExecStart=%h/server/chickenbot/venv/bin/chickenbot
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
